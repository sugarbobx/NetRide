# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/netride?schema=public"

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── Africa's Talking (OTP) ────────────────────────────
# Leave AT_API_KEY empty to use mock OTP (code: 1234)
AT_USERNAME=sandbox
AT_API_KEY=

# ── Campay (Mobile Money) ─────────────────────────────
# Leave CAMPAY_USERNAME empty to use mock payment flow
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_BASE_URL=https://demo.campay.net/api

# ── Super Admin Seed ──────────────────────────────────
SEED_ADMIN_PHONE=+237600000001
SEED_ADMIN_NAME=Super Admin
